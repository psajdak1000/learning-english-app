    "jsdom": "^24.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.23.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.368.0",
    "vitest": "^1.6.0"
  }
